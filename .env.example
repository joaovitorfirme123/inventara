# PostgreSQL local (Docker)
POSTGRES_USER=inventara
POSTGRES_PASSWORD=inventara_local
POSTGRES_DB=inventara
POSTGRES_PORT=5432

# Used only on the server. Never prefix database credentials with NEXT_PUBLIC_.
DATABASE_URL=postgresql://inventara:inventara_local@localhost:5432/inventara?schema=public

# Optional direct connection for Prisma migrations in production. Leave empty locally.
# DIRECT_URL=postgresql://user:password@direct-host.neon.tech/dbname?sslmode=require

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Used only to provision local test accounts with `npm run db:seed`.
SEED_USER_PASSWORD=replace-with-a-local-password-at-least-8-characters

# Optional dedicated password for the synthetic public demo account.
DEMO_USER_PASSWORD=replace-with-a-demo-password-at-least-8-characters
