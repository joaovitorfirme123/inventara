# PostgreSQL local (Docker)
POSTGRES_USER=inventara
POSTGRES_PASSWORD=inventara_local
POSTGRES_DB=inventara
POSTGRES_PORT=5432

# Used only on the server. Never prefix database credentials with NEXT_PUBLIC_.
DATABASE_URL=postgresql://inventara:inventara_local@localhost:5432/inventara?schema=public

# Temporary tenant context until authentication is implemented.
DEVELOPMENT_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
