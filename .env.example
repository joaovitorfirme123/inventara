# PostgreSQL local (Docker)
POSTGRES_USER=inventara
POSTGRES_PASSWORD=inventara_local
POSTGRES_DB=inventara
POSTGRES_PORT=5432

# Used only on the server. Never prefix database credentials with NEXT_PUBLIC_.
DATABASE_URL=postgresql://inventara:inventara_local@localhost:5432/inventara?schema=public

# Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Used only to provision local test accounts with `npm run db:seed`.
SEED_USER_PASSWORD=replace-with-a-local-password-at-least-8-characters
