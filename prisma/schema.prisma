generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  MEMBER
}

enum ImportRowStatus {
  INSERTED
  UPDATED
  ERROR
}

enum InventoryPlanStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model Organization {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  users        User[]
  products     Product[]
  imports      ImportRecord[]
  stockHistory StockHistory[]
  inventoryPlans InventoryPlan[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  email          String       @unique
  emailVerified  Boolean      @default(false) @map("email_verified")
  image          String?
  role           UserRole     @default(MEMBER)
  isActive       Boolean      @default(true) @map("is_active")
  organizationId String?      @map("organization_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions       Session[]
  accounts       Account[]
  inventoryPlans InventoryPlan[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([issuer, accountId], map: "accounts_issuer_account_id_key")
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Product {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  plu            String
  barcode        String?
  description    String
  section        String?
  group          String?
  subgroup       String?
  lastInventory  DateTime?      @map("last_inventory") @db.Date
  currentStock   Decimal        @default(0) @map("current_stock") @db.Decimal(15, 3)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockHistory   StockHistory[]
  importRows     ImportRow[]

  @@unique([organizationId, plu])
  @@index([organizationId, description])
  @@index([organizationId, barcode])
  @@index([organizationId, section, group, subgroup])
  @@map("products")
}

model ImportRecord {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  filename       String
  fileHash       String?        @map("file_hash")
  importedAt     DateTime       @default(now()) @map("imported_at")
  totalRows      Int            @map("total_rows")
  insertedRows   Int            @map("inserted_rows")
  updatedRows    Int            @map("updated_rows")
  errorRows      Int            @map("error_rows")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockHistory   StockHistory[]
  rows           ImportRow[]

  @@index([organizationId, importedAt(sort: Desc)])
  @@index([organizationId, fileHash])
  @@map("imports")
}

model ImportRow {
  id             String         @id @default(uuid()) @db.Uuid
  importId       String         @map("import_id") @db.Uuid
  rowNumber      Int            @map("row_number")
  status         ImportRowStatus
  plu            String?
  description    String?
  field          String?
  message        String?
  productId      String?        @map("product_id") @db.Uuid
  importRecord   ImportRecord    @relation(fields: [importId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@map("import_rows")
}

model StockHistory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  importId       String       @map("import_id") @db.Uuid
  stock          Decimal      @db.Decimal(15, 3)
  recordedAt     DateTime     @default(now()) @map("recorded_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  importRecord   ImportRecord @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([importId, productId])
  @@index([organizationId, productId, recordedAt(sort: Desc)])
  @@index([organizationId, importId])
  @@map("stock_history")
}

model InventoryPlan {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  section        String
  group          String
  subgroup       String
  priority       String
  priorityScore  Float               @map("priority_score")
  totalSkus      Int                 @map("total_skus")
  pendingSkus    Int                 @map("pending_skus")
  plannedDate    DateTime?           @map("planned_date") @db.Date
  responsibleId  String?             @map("responsible_id") @db.Uuid
  status         InventoryPlanStatus @default(PENDING)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  responsible    User?               @relation(fields: [responsibleId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, plannedDate])
  @@index([organizationId, section, group, subgroup])
  @@map("inventory_plans")
}
