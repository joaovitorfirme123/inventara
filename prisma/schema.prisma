generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  MEMBER
}

enum ImportRowStatus {
  INSERTED
  UPDATED
  ERROR
}

enum InventoryPlanStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model Organization {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  users        User[]
  products     Product[]
  imports      ImportRecord[]
  stockHistory StockHistory[]
  inventoryPlans InventoryPlan[]
  inventoryGoals InventoryGoal[]
  inventoryCoverage InventoryCoverage[]
  notifications Notification[]
  invitations OrganizationInvite[]
  auditLogs AuditLog[]
  importTemplates ImportTemplate[]
  priorityRule PriorityRule?

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  email          String       @unique
  emailVerified  Boolean      @default(false) @map("email_verified")
  image          String?
  role           UserRole     @default(MEMBER)
  isActive       Boolean      @default(true) @map("is_active")
  organizationId String?      @map("organization_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions       Session[]
  accounts       Account[]
  notificationReads NotificationRead[]
  organizationInvites OrganizationInvite[] @relation("InvitesCreated")
  auditLogs AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([issuer, accountId], map: "accounts_issuer_account_id_key")
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

model Product {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  plu            String
  barcode        String?
  description    String
  section        String?
  group          String?
  subgroup       String?
  lastInventory  DateTime?      @map("last_inventory") @db.Date
  currentStock   Decimal        @default(0) @map("current_stock") @db.Decimal(15, 3)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockHistory   StockHistory[]
  importRows     ImportRow[]

  @@unique([organizationId, plu])
  @@index([organizationId, description])
  @@index([organizationId, barcode])
  @@index([organizationId, section, group, subgroup])
  @@map("products")
}

model ImportRecord {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  filename       String
  fileHash       String?        @map("file_hash")
  importedAt     DateTime       @default(now()) @map("imported_at")
  totalRows      Int            @map("total_rows")
  insertedRows   Int            @map("inserted_rows")
  updatedRows    Int            @map("updated_rows")
  errorRows      Int            @map("error_rows")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockHistory   StockHistory[]
  rows           ImportRow[]
  templateRevisionId String? @map("template_revision_id") @db.Uuid
  templateRevision ImportTemplateRevision? @relation(fields: [templateRevisionId], references: [id], onDelete: SetNull)

  @@index([organizationId, importedAt(sort: Desc)])
  @@index([organizationId, fileHash])
  @@map("imports")
}

model ImportRow {
  id             String         @id @default(uuid()) @db.Uuid
  importId       String         @map("import_id") @db.Uuid
  rowNumber      Int            @map("row_number")
  status         ImportRowStatus
  plu            String?
  description    String?
  field          String?
  message        String?
  productId      String?        @map("product_id") @db.Uuid
  importRecord   ImportRecord    @relation(fields: [importId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@map("import_rows")
}

model StockHistory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  importId       String       @map("import_id") @db.Uuid
  stock          Decimal      @db.Decimal(15, 3)
  recordedAt     DateTime     @default(now()) @map("recorded_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  importRecord   ImportRecord @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@unique([importId, productId])
  @@index([organizationId, productId, recordedAt(sort: Desc)])
  @@index([organizationId, importId])
  @@map("stock_history")
}

model InventoryPlan {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  section        String
  group          String
  subgroup       String
  priority       String
  priorityScore  Float               @map("priority_score")
  totalSkus      Int                 @map("total_skus")
  pendingSkus    Int                 @map("pending_skus")
  plannedDate    DateTime?           @map("planned_date") @db.Date
  responsibleName String?            @map("responsible_name")
  status         InventoryPlanStatus @default(PENDING)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  priorityRuleRevisionId String?       @map("priority_rule_revision_id") @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  priorityRuleRevision PriorityRuleRevision? @relation(fields: [priorityRuleRevisionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, plannedDate])
  @@index([organizationId, section, group, subgroup])
  @@map("inventory_plans")
}

model InventoryGoal {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  year              Int
  section           String
  targetPercentage  Float        @map("target_percentage")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, year, section])
  @@index([organizationId, year])
  @@map("inventory_goals")
}

model InventoryCoverage {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  year               Int
  month              Int
  section            String
  totalSkus          Int          @map("total_skus")
  countedSkus        Int          @map("counted_skus")
  coveragePercentage Float        @map("coverage_percentage")
  recordedAt         DateTime     @map("recorded_at")
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, year, month, section])
  @@index([organizationId, year, month])
  @@map("inventory_coverage")
}

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  dedupeKey      String             @map("dedupe_key")
  type           String
  severity       String
  title          String
  message        String
  generatedAt    DateTime           @default(now()) @map("generated_at")
  resolvedAt     DateTime?          @map("resolved_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reads          NotificationRead[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, resolvedAt, generatedAt(sort: Desc)])
  @@map("notifications")
}

model NotificationRead {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_reads")
}

model OrganizationInvite {
  id           String       @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  invitedById  String       @map("invited_by_id") @db.Uuid
  email        String
  tokenHash    String       @unique @map("token_hash")
  expiresAt    DateTime     @map("expires_at")
  acceptedAt   DateTime?    @map("accepted_at")
  revokedAt    DateTime?    @map("revoked_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitesCreated", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([email, expiresAt])
  @@map("organization_invites")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

model ImportTemplate {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  revisions      ImportTemplateRevision[]

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("import_templates")
}

model ImportTemplateRevision {
  id          String         @id @default(uuid()) @db.Uuid
  templateId  String         @map("template_id") @db.Uuid
  version     Int
  configuration Json
  createdAt   DateTime       @default(now()) @map("created_at")
  template    ImportTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  imports     ImportRecord[]

  @@unique([templateId, version])
  @@index([templateId, version(sort: Desc)])
  @@map("import_template_revisions")
}

model PriorityRule {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @unique @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  revisions      PriorityRuleRevision[]

  @@map("priority_rules")
}

model PriorityRuleRevision {
  id             String         @id @default(uuid()) @db.Uuid
  ruleId         String         @map("rule_id") @db.Uuid
  version        Int
  configuration  Json
  createdAt      DateTime       @default(now()) @map("created_at")
  rule           PriorityRule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  inventoryPlans InventoryPlan[]

  @@unique([ruleId, version])
  @@index([ruleId, version(sort: Desc)])
  @@map("priority_rule_revisions")
}
